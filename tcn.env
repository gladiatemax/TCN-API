# Configurazione del nodo centrale.
#   source tcn.env
# Le variabili vanno esportate PRIMA di avviare uvicorn o la CLI:
# config.py le legge una volta sola all'import.

# Chiave privata del dealer (Ed25519, PEM).
# Firma le share SG02; la sua pubblica e' cablata nel firmware.
export TCN_DEALER_KEY="$HOME/Scrivania/Tesi/notebooks/dealer_sk.pem"

# Binari host
export TCN_THETACLI="$HOME/Scrivania/Tesi/thetacrypt/src/target/release/thetacli"
export TCN_PFSE_TOOL="$HOME/Scrivania/Tesi/forwardCLI/pfse_tool_bn254"

# Schema a soglia. Con una sola Nitrokey collegata k=n=1:
# la soglia e' degenere e non dimostra nulla di crittografico, ma
# esercita l'intera catena. Con tre token: k=2 n=3 oppure k=3 n=3.
export TCN_SG02_K=2
export TCN_SG02_N=2

# GMPpke: d tag per crittogramma, deciso al keygen.
export TCN_PPKE_D=3

# Stato persistente. In esercizio con systemd: /var/lib/tcn
# export TCN_STATE_DIR="$HOME/.local/share/tcn"
